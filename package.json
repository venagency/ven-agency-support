{
  "name": "ven-agency-support",
  "version": "1.3.3",
  "private": true,
  "description": "Ven Agency WordPress support assistant plugin and Cloudflare Worker gateway.",
  "type": "module",
  "scripts": {
    "plugin:lint": "php -l ven-agency-support/ven-agency-support.php",
    "plugin:zip": "rm -f ven-agency-support.zip && zip -r ven-agency-support.zip ven-agency-support -x '*.DS_Store'",
    "worker:dev": "cd cloudflare/ven-support-task-gateway && npx wrangler dev",
    "worker:deploy": "cd cloudflare/ven-support-task-gateway && npx wrangler deploy",
    "worker:types": "cd cloudflare/ven-support-task-gateway && npx wrangler types"
  }
}
